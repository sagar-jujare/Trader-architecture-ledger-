# Neon pooled connection string (runtime)
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-POOLER-HOST.neon.tech/neondb?sslmode=require"
# Neon direct connection string (Prisma migrations)
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-DIRECT-HOST.neon.tech/neondb?sslmode=require"
SESSION_SECRET="REPLACE_WITH_A_RANDOM_64_CHARACTER_SECRET"
APP_URL="http://localhost:3000"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="REPLACE_WITH_A_STRONG_UNIQUE_PASSWORD"
# Paste an existing Cashfree-hosted payment link. Never put API secrets in NEXT_PUBLIC_ variables.
CASHFREE_PAYMENT_LINK="https://payments.cashfree.com/links/YOUR_LINK"
PAYMENT_UPI_ID="merchant@upi"
PAYMENT_BANK_NAME="Example Bank"
PAYMENT_ACCOUNT_NAME="Example Business"
PAYMENT_ACCOUNT_NUMBER="000000000000"
PAYMENT_IFSC="ABCD0000000"

# Automatic invitation email via Resend. Verify your sending domain in Resend first.
RESEND_API_KEY=""
INVITE_FROM_EMAIL="TradeLedger <invites@your-verified-domain.com>"

# OPTIONAL: Automatic WhatsApp invitations via Meta WhatsApp Business Cloud API.
# Requires a WhatsApp Business account, permanent access token and approved
# template with two body text parameters: name and full invite URL.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_INVITE_TEMPLATE=""
WHATSAPP_TEMPLATE_LANGUAGE="en_US"
